<%- include('partials/head', { titulo: 'Editar ' + lugar.nombre }) %>

<a class="volver" href="/lugar/<%= lugar.slug %>">← Volver a <%= lugar.nombre %></a>

<section class="detalle">
  <header class="detalle__encabezado">
    <span class="etiqueta">Editar lugar</span>
    <h1><%= lugar.nombre %></h1>
  </header>

  <% if (errores.length) { %>
    <ul class="aviso aviso--error errores">
      <% errores.forEach(e => { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>

  <form class="formulario" method="post" action="/lugar/<%= lugar.slug %>/editar">
    <div class="formulario__fila">
      <label>Nombre
        <input name="nombre" value="<%= lugar.nombre %>" maxlength="<%= LIMITES.nombre %>" required>
      </label>
      <label>Municipio
        <input name="municipio" value="<%= lugar.municipio %>" maxlength="<%= LIMITES.municipio %>" required>
      </label>
    </div>
    <div class="formulario__fila">
      <label>Categoría
        <input name="categoria" value="<%= lugar.categoria %>" maxlength="<%= LIMITES.categoria %>" required>
      </label>
      <label>Ubicación para el mapa
        <input name="mapa" value="<%= lugar.mapa %>" maxlength="<%= LIMITES.mapa %>" required>
      </label>
    </div>
    <label>Resumen
      <input name="resumen" value="<%= lugar.resumen %>" maxlength="<%= LIMITES.resumen %>" required>
    </label>
    <label>Descripción
      <textarea name="descripcion" rows="6" maxlength="<%= LIMITES.descripcion %>" required><%= lugar.descripcion %></textarea>
    </label>
    <div class="formulario__fila">
      <label>URL de la imagen
        <input type="url" name="imagen_url" value="<%= lugar.imagen_url %>" maxlength="<%= LIMITES.imagen_url %>" required>
      </label>
      <label>Fuente de la imagen
        <input type="url" name="imagen_fuente" value="<%= lugar.imagen_fuente %>" maxlength="<%= LIMITES.imagen_fuente %>" required>
      </label>
    </div>
    <label>Video de YouTube (ID o enlace)
      <input name="video_id" value="<%= lugar.video_id %>" maxlength="200" required>
    </label>
    <button type="submit">Guardar cambios</button>
  </form>
</section>

<%- include('partials/foot') %>
